{
  "name": "liquid-glass-screens",
  "main": "expo-router/entry",
  "react-native": "./src/index.ts",
  "types": "./src/index.ts",
  "version": "1.0.0",
  "description": "Open-source React Native Expo cookbook with two liquid-glass welcome screens: a daylight sky and a night sky, both driven by one swipe-up glass sphere.",
  "keywords": [
    "expo",
    "react-native",
    "expo-router",
    "typescript",
    "reanimated",
    "react-native-skia",
    "liquid-glass",
    "glassmorphism",
    "welcome-screen",
    "onboarding-screen",
    "splash-screen",
    "shader",
    "react-native-ui",
    "expo-template",
    "mobile-ui",
    "ios",
    "android",
    "open-source",
    "app-design"
  ],
  "license": "GPL-3.0-only",
  "author": {
    "name": "Appllama",
    "url": "https://appllama.io"
  },
  "contributors": [
    {
      "name": "Jaimin",
      "url": "https://x.com/jaimintf"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Appllama/liquid-glass-screens.git"
  },
  "homepage": "https://github.com/Appllama/liquid-glass-screens#readme",
  "bugs": {
    "url": "https://github.com/Appllama/liquid-glass-screens/issues"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "assets/cookbooks",
    "assets/images/liquid-glass-icon.png",
    "assets/images/liquid-glass-favicon.png",
    "docs",
    "packages",
    "prompts",
    "src/index.ts",
    "src/liquid-glass",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "sideEffects": false,
  "dependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.19",
    "expo-asset": "~57.0.9",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "decode-uri-component": "file:packages/decode-uri-component-compat",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test:dependencies && npm run test:motion",
    "test:dependencies": "node --test tests/dependency-compatibility.test.cjs",
    "test:motion": "node --test tests/sticker-exit.test.cjs"
  },
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
